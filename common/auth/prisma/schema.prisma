generator client {
  provider = "prisma-client-js"
  output   = "../generated"
}

datasource db {
  provider  = "postgresql"
  url       = env("USER_DB_URL")
  directUrl = env("USER_DIRECT_URL")
}

enum Role {
  user
  admin
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      Role     @default(user)
  isAccept  Boolean  @default(false)
  createdAt DateTime @default(now())
}

PORT=3000
JWT_SECRET=<random-long-secret>
FRONTEND_ORIGIN=http://localhost:5173

VIDEO_DB_URL=mongodb+srv://<user>:<pass>@<cluster>/video?retryWrites=true&w=majority

# Supabase pooled connection (pgbouncer, port 6543) — used at runtime
TASKS_DB_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres?pgbouncer=true
# Supabase direct connection (port 5432) — used for prisma migrate
TASKS_DIRECT_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres

# DB user trung tâm — connection riêng, Postgres qua Prisma (Supabase)
USER_DB_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres?pgbouncer=true
USER_DIRECT_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres
